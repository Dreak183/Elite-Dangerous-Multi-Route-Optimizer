[Unit]
Description=EDMRN crew relay
After=network-online.target
Wants=network-online.target

[Service]
User=edmrn-relay
Group=edmrn-relay
WorkingDirectory=/opt/edmrn
Environment=PYTHONPATH=/opt/edmrn:/opt/edmrn/relay
EnvironmentFile=/etc/edmrn-relay.env
ExecStart=/opt/edmrn/.venv-relay/bin/python -m edmrn_relay --db /var/lib/edmrn-relay/relay.db
StateDirectory=edmrn-relay
Restart=on-failure
KillSignal=SIGTERM
# A stop waits up to 15 s (SHUTDOWN_GRACE) for queued closes plus websockets' close handshake (10 s);
# a shorter timeout would SIGKILL the relay before it has persisted the statuses.
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
